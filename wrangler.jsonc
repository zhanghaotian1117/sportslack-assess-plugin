{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sportslack-assess",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-23",
  "account_id": "a4d5f2cd4e3e3ad563752439404c56b9",
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "ai.sportslack.com/v4/assess/*",
      "zone_name": "sportslack.com"
    },
    {
      "pattern": "ai.sportslack.com/v4/assess",
      "zone_name": "sportslack.com"
    },
    {
      "pattern": "sportslack.com/v4/assess/*",
      "zone_name": "sportslack.com"
    },
    {
      "pattern": "sportslack.com/v4/assess",
      "zone_name": "sportslack.com"
    },
    {
      "pattern": "www.sportslack.com/v4/assess/*",
      "zone_name": "sportslack.com"
    },
    {
      "pattern": "www.sportslack.com/v4/assess",
      "zone_name": "sportslack.com"
    }
  ],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "sportslack-auth",
      "database_id": "1760d17c-d7cb-4180-8ac4-0b10b35c30e8"
    }
  ],
  "services": [
    {
      "binding": "PLUGIN_CENTER",
      "service": "sportslack-plugin-center"
    }
  ],
  "vars": {
    "ASSESS_BACKEND_ORIGIN": "https://v4-assess-backend.sportslack.com"
  },
  "observability": {
    "enabled": true
  }
}
