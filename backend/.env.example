PORT=8000
NODE_ENV=production

# Optional. Local development only. Production requests should be authenticated
# by the Sportslack Cloudflare Worker headers instead of this JWT secret.
JWT_SECRET=change-this-only-if-local-jwt-login-is-used

# SQLite database path. Defaults to ./exam.db.
# Production should mount a persistent data directory and set this to /data/exam.db.
DATABASE_PATH=/data/exam.db
DATABASE_BACKUP_DIR=/data/backups
PASSWORD_VAULT_KEY_PATH=/data/.password-vault-key
